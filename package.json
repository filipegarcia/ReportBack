{
  "name": "reportback",
  "version": "0.1.0",
  "description": "Feedback and bug-report tool à la YouTube — a draggable, in-page widget that captures a screenshot, page metadata, and a user-written description.",
  "author": {
    "name": "Filipe Garcia",
    "email": "hello@evolving.in"
  },
  "private": true,
  "license": "Apache-2.0",
  "main": "index.html",
  "keywords": [
    "report",
    "bug",
    "feedback",
    "screenshot",
    "html2canvas"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/filipegarcia/ReportBack.git"
  },
  "scripts": {
    "start": "http-server -p 8080 -c-1 --silent .",
    "serve": "http-server -p 8080 -c-1 .",
    "test:e2e": "playwright test",
    "test:e2e:screenshots": "playwright test tests/e2e/screenshots.spec.js",
    "screenshots": "playwright test tests/e2e/screenshots.spec.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "http-server": "^14.1.1"
  }
}
